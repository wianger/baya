{
  "name": "@wianger/baya",
  "version": "4.15.0",
  "description": "Baya host: runs ACP coding agents on this computer for the Baya phone app.",
  "type": "module",
  "main": "dist/cli.js",
  "types": "dist/cli.d.ts",
  "bin": {
    "baya": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p test",
    "dev": "node src/cli.ts",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome check --write .",
    "prepublishOnly": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "build:binary": "node scripts/build-binary.mjs"
  },
  "keywords": [
    "baya",
    "acp",
    "agent-client-protocol",
    "coding-agent",
    "remote-control",
    "mobile"
  ],
  "author": "wianger",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wianger/baya.git",
    "directory": "host"
  },
  "bugs": {
    "url": "https://github.com/wianger/baya/issues"
  },
  "homepage": "https://github.com/wianger/baya",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.1",
    "esbuild": "0.28.2",
    "postject": "1.0.0-alpha.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@napi-rs/keyring": "^2.1.2",
    "uqr": "^0.1.3",
    "ws": "^8.22.2"
  },
  "packageManager": "pnpm@11.5.3",
  "knip": {
    "entry": [
      "test/make-noise-vector.ts",
      "scripts/keyring-sea.cjs"
    ]
  }
}
