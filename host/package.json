{
  "name": "@wianger/baya",
  "version": "4.0.0",
  "description": "Baya host: runs ACP coding agents on this computer for the Baya phone app.",
  "type": "module",
  "main": "dist/cli.js",
  "types": "dist/cli.d.ts",
  "bin": {
    "baya": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p test",
    "dev": "node src/cli.ts",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome check --write .",
    "prepublishOnly": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "keywords": [
    "baya",
    "acp",
    "agent-client-protocol",
    "coding-agent",
    "remote-control",
    "mobile"
  ],
  "author": "wianger",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wianger/baya.git",
    "directory": "host"
  },
  "bugs": {
    "url": "https://github.com/wianger/baya/issues"
  },
  "homepage": "https://github.com/wianger/baya",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^25.8.0",
    "@types/ws": "^8.18.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "@napi-rs/keyring": "^1.3.0",
    "uqr": "^0.1.3",
    "ws": "^8.21.0"
  },
  "packageManager": "pnpm@11.5.3"
}
